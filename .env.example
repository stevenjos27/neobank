# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5432/neobank"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Comma-separated list of browser origins allowed by CORS
WEB_ORIGINS="http://localhost:4200"
BANK_IFSC="NEOB0000001"

# --- AI ---
AI_PROVIDER=openai
OPENAI_API_KEY=
# Milliseconds to wait for a single OpenAI request before aborting. Optional;
# defaults to 30000. Must parse as a positive number or the provider throws at
# startup. Chat completions with tool calls have been observed at 70-100s on a
# slow link, so raise this - not lower it - if you see APIConnectionTimeoutError
# on requests the API eventually answers.
AI_REQUEST_TIMEOUT_MS=120000
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
