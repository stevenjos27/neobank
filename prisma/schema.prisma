// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(CUSTOMER)
  accounts     Account[]
  payees       Payee[]
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Account {
  id            String        @id @default(uuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  accountNumber String        @unique
  type          AccountType   @default(SAVINGS)
  balancePaise  BigInt        @default(0)
  currency      String        @default("INR")
  transactions  Transaction[]
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model Transaction {
  id          String                 @id @default(uuid())
  account     Account                @relation(fields: [accountId], references: [id])
  accountId   String
  type        TransactionType
  amountPaise BigInt
  description String?
  createdAt   DateTime               @default(now())
  enrichment  TransactionEnrichment?

  @@index([accountId, createdAt(sort: Desc), id(sort: Desc)])
}

/// AI-derived data about a transaction. Deliberately NOT on the ledger row:
/// a model's guess that "SWIGGY*ORDER 8837" is Food & Dining is derived,
/// re-computable and disposable; the money is none of those things.
///
/// TWO independent AI passes write to this row — the embedder and the
/// categoriser — and they use DIFFERENT models. They therefore need separate
/// version columns. A single shared `modelVersion` would mean each pass sees
/// the other's model name and concludes its own work is stale, so every run
/// would redo all of it, forever, at full cost.
model TransactionEnrichment {
  id            String      @id @default(uuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String      @unique

  /// Set by the categoriser. Null means "not categorised", which is NOT the
  /// same as the category `Other` — that is a real verdict of "none of the
  /// listed categories fit".
  category             String?
  confidence           Float?
  /// The CHAT model that produced `category`. Null until categorised.
  categoryModelVersion String?

  /// The EMBEDDING model that produced `embedding`. Null until embedded.
  /// Nullable because either pass may create this row first, so a row can
  /// legitimately exist with a category and no vector, or the reverse.
  embeddingModelVersion String?
  embedding             Unsupported("vector(1536)")?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
}

/// A chunk of a knowledge-base document. Global — no userId, by design.
model KnowledgeChunk {
  source       String
  heading      String
  content      String
  chunkIndex   Int
  /// Hash of `content`. The backfill skips chunks whose text hasn't changed,
  /// so re-running after editing one FAQ section re-embeds one section.
  contentHash  String
  /// Stays `modelVersion` here, unqualified, because this table has exactly
  /// one model: chunks are embedded and never categorised. The name is only
  /// ambiguous where two models write to the same row.
  modelVersion String
  embedding    Unsupported("vector(1536)")?
  id           String                       @id @default(uuid())
  createdAt    DateTime                     @default(now())

  @@unique([source, chunkIndex])
}

model Payee {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  name          String
  accountNumber String
  ifsc          String
  createdAt     DateTime @default(now())

  @@unique([userId, accountNumber])
}

/// Why a session ended. An enum rather than free text: the reuse branch is a
/// security event, and "count sessions revoked for reuse" should be a query on
/// a closed set of values, not a string match on whatever someone typed.
enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  REUSE
}

/// One login. Logout, logout-all and reuse detection all act HERE, on one row,
/// rather than on every token in the rotation chain.
///
/// `expiresAt` is the ABSOLUTE cap (login + 30 days) and is never extended.
/// Rotation alone would slide a weekly-refreshed session forward forever.
model Session {
  id            String               @id @default(uuid())
  user          User                 @relation(fields: [userId], references: [id])
  userId        String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason SessionRevokeReason?
  tokens        RefreshToken[]
  createdAt     DateTime             @default(now())

  @@index([userId])
}

/// One refresh token per rotation. The token itself is NEVER stored: it is 32
/// random bytes handed to the client once, and only its SHA-256 lives here, so
/// a leaked backup contains no usable tokens. SHA-256 rather than argon2
/// because a 256-bit random value cannot be guessed — slow hashing protects
/// guessable secrets (passwords), and it would also rule out the unique-index
/// lookup below.
///
/// `usedAt` is set by ONE conditional UPDATE when the token is rotated. Seeing
/// it already set means the token is being presented again: a concurrent
/// request inside the grace window, or a replay — see AuthService.
model RefreshToken {
  id        String    @id @default(uuid())
  session   Session   @relation(fields: [sessionId], references: [id])
  sessionId String
  tokenHash String    @unique
  /// Idle timeout: issue time + 7 days, capped at the session's expiresAt.
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId])
}
