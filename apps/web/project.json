{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "dev": {
      "command": "next dev -p 4200",
      "options": {
        "cwd": "apps/web"
      },
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "options": {
        "command": "tsc -p apps/web/tsconfig.json --noEmit"
      }
    }
  }
}
