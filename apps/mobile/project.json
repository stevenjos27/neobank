{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile",
  "projectType": "application",
  "tags": [],
  "// targets": "start/android/ios/web are inferred from package.json scripts",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "options": {
        "cwd": "apps/mobile",
        "command": "pnpm exec tsc --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "options": {
        "cwd": "apps/mobile",
        "command": "pnpm exec jest --ci"
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "apps/mobile",
        "command": "pnpm exec expo export --platform ios --platform android --output-dir dist"
      }
    }
  }
}