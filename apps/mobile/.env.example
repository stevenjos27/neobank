# NeoBank mobile environment. Copy to .env.local (git-ignored), then
# uncomment exactly ONE EXPO_PUBLIC_API_URL line below.
#
# EXPO_PUBLIC_ values are inlined into the app bundle at build time and
# can be read by anyone who has the app. Never put a secret in one.
#
# After any change, restart Metro with a clean cache, or the old value
# stays inlined:   pnpm expo start --clear
#
# The base URL INCLUDES the /api prefix (same convention as the web
# app's API_URL). A trailing slash is optional.

# A) Local API on your LAN. Development builds only: http is refused
#    in release builds. Use the Mac's LAN IP, not localhost: on a phone,
#    "localhost" is the phone itself. (The iOS simulator shares the Mac's
#    network, so localhost works there; the Android emulator reaches the
#    Mac at 10.0.2.2.)
# EXPO_PUBLIC_API_URL=http://<mac-lan-ip>:3000/api

# B) Deployed API over HTTPS. Works anywhere, any build.
# EXPO_PUBLIC_API_URL=https://<api-host>/api
